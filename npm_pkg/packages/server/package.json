{
  "name": "@skycanvasstudio/serve-server",
  "version": "0.1.0",
  "description": "Framework-neutral server SDK for File Server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/fetch": {
      "import": {
        "types": "./dist/adapters/fetch.d.ts",
        "default": "./dist/adapters/fetch.js"
      },
      "require": {
        "types": "./dist/adapters/fetch.d.cts",
        "default": "./dist/adapters/fetch.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalids01/serve.git",
    "directory": "npm_pkg/packages/server"
  },
  "homepage": "https://github.com/khalids01/serve#readme",
  "bugs": {
    "url": "https://github.com/khalids01/serve/issues"
  },
  "keywords": [
    "file-server",
    "upload",
    "storage",
    "typescript",
    "server"
  ],
  "publishConfig": {
    "access": "public"
  }
}
