# Database
DATABASE_URL="file:../../dev.db"

# Email credentials (host/port/from are in src/config.ts)
EMAIL=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# App Configuration (deployment-specific URLs)
NEXT_PUBLIC_APP_URL=http://localhost:4000
# Optional: override API base URL for client requests (defaults to same-origin)
# NEXT_PUBLIC_BASE_URL=
# Optional: Better Auth base URL when behind a reverse proxy
# BETTER_AUTH_URL=http://localhost:4000

# Authentication
BETTER_AUTH_SECRET="your-secret-key-here-change-in-production"

# S3-compatible object storage — only when config.storage.provider is "s3"
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://s3.ap-northeast-1.idrivee2.com

# All other settings (upload limits, image optimization, SMTP host/port,
# storage provider, UPLOAD_DIR, signup toggle) are in src/config.ts.
