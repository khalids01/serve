# Database
DATABASE_URL="file:../../dev.db"

# Email Configuration (Optional - for magic link authentication)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="Serve File Storage"

# App Configuration (deployment-specific URLs)
NEXT_PUBLIC_APP_URL=http://localhost:4000
# Optional: override API base URL for client requests (defaults to same-origin)
# NEXT_PUBLIC_BASE_URL=
# Optional: Better Auth base URL when behind a reverse proxy
# BETTER_AUTH_URL=http://localhost:4000

# Authentication
BETTER_AUTH_SECRET="your-secret-key-here-change-in-production"

# Client upload limit (MB) — keep in sync with config.upload.publicMaxFileSizeMb in src/config.ts
NEXT_PUBLIC_MAX_FILE_SIZE=50

# Local storage (used when config.storage.provider is "local" in src/config.ts)
UPLOAD_DIR=uploads

# S3-compatible object storage (used when config.storage.provider is "s3" in src/config.ts)
# Works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Non-secret app settings (upload limits, image optimization, storage provider, signup toggle)
# are configured in src/config.ts — not in this file.
