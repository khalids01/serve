# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/serve"

# Email credentials (host/port/from are in src/config.ts)
EMAIL=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# App Configuration (deployment-specific URLs)
NEXT_PUBLIC_APP_URL=http://localhost:5000
# Optional: override API base URL for client requests (defaults to same-origin)
# NEXT_PUBLIC_BASE_URL=
# Optional: Better Auth base URL when behind a reverse proxy
# BETTER_AUTH_URL=http://localhost:5000
# Upload size in MB. Set both values to the same number for dashboard uploads.
MAX_FILE_SIZE_MB=50
NEXT_PUBLIC_MAX_FILE_SIZE=50

# Authentication
# After signing up, run the admin promotion command for this email. Signups are controlled in Settings.
ADMIN_EMAIL=admin@example.com
BETTER_AUTH_SECRET="your-secret-key-here-change-in-production"
# Dedicated browser-management signing secret. Generate: openssl rand -base64 32
FILE_SERVER_BROWSER_TOKEN_SECRET=""

# Local development defaults. Production can use STORAGE_PROVIDER=s3.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# S3-compatible object storage — only when STORAGE_PROVIDER=s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://s3.ap-northeast-1.idrivee2.com

# Image processing and SMTP host/port settings are in src/config.ts.
# For Dokploy, use .env.production.example and docs/deployment.md.

# Optional: save encrypted S3 connections through Dashboard → Storage.
# Generate once with openssl rand -base64 32 and retain across redeployments.
# STORAGE_ENCRYPTION_KEY=
# STORAGE_ENCRYPTION_PREVIOUS_KEYS=
# STORAGE_ALLOWED_PRIVATE_HOSTS=minio

# GitHub OAuth App: callback URL is <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
