# Dokploy Compose service Environment settings (not GitHub build credentials).
IMAGE_REPOSITORY=khalids01/serve
# main follows the successfully published moving tags; sha-FULL_COMMIT pins a release.
IMAGE_TAG=main
DATABASE_URL=postgresql://serve:URL_ENCODED_PASSWORD@POSTGRES_SERVICE:5432/serve
# Must match the public GitHub Actions build variable exactly.
NEXT_PUBLIC_APP_URL=https://files.example.com
NEXT_PUBLIC_MAX_FILE_SIZE=50
MAX_FILE_SIZE_MB=50
# Generate each independently with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
FILE_SERVER_BROWSER_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# Enable for first account creation, then disable if desired.
ENABLE_SIGNUP=false
EMAIL=your-email@gmail.com
EMAIL_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
# Default uses these settings. Local can also be selected per application.
# Saved S3 connections need a dedicated key; keep it across deployments.
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_32
# STORAGE_ENCRYPTION_PREVIOUS_KEYS=old-base64-key
# STORAGE_ALLOWED_PRIVATE_HOSTS=minio
# local uses the persistent serve-uploads volume; s3 uses the settings below.
STORAGE_PROVIDER=s3
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET=REPLACE_ME
S3_REGION=auto
S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com
# SQL backups require a pg_dump client compatible with your PostgreSQL server.
BACKUP_ENABLED=true

# GitHub OAuth App: callback URL is <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
