model Application {
  id                       String             @id @default(cuid())
  name                     String
  slug                     String             @unique
  ownerId                  String
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  defaultStorageLocationId String             @default("default")
  folders                  Folder[]
  storageDir               String // e.g., "uploads/<appId>"
  imageApplications        ImageApplication[]
  apiKeys                  ApiKey[]
  members                  User[]             @relation("UserApplications")
  auditLogs                AuditLog[]
}

model Image {
  id                String             @id @default(cuid())
  filename          String
  contentType       String
  sizeBytes         Int
  width             Int?
  height            Int?
  hash              String
  ownerId           String             @default("")
  storageLocationId String             @default("system")
  storageConfig     Json?
  variants          ImageVariant[]
  applications      ImageApplication[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([storageLocationId, hash])
  @@index([ownerId, storageLocationId])
}

model ImageApplication {
  id            String    @id @default(cuid())
  imageId       String
  applicationId String
  originalName  String
  tags          Json?
  folderId      String?
  deletedAt     DateTime?
  trashBatchId  String?
  starred       Boolean   @default(false)
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: Restrict)
  linkedAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  image       Image       @relation(fields: [imageId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([imageId, applicationId])
  @@index([applicationId, folderId, deletedAt])
  @@index([applicationId, updatedAt(sort: Desc)])
}

model ImageVariant {
  id        String   @id @default(cuid())
  imageId   String
  label     String // e.g., "thumb", "1024w", "webp"
  filename  String
  width     Int?
  height    Int?
  sizeBytes Int
  createdAt DateTime @default(now())

  image Image @relation(fields: [imageId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model ApiKey {
  id            String    @id @default(cuid())
  applicationId String
  userId        String
  name          String
  // Store only a hash of the key, never the raw value
  hash          String    @unique
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  revoked       Boolean   @default(false)

  application Application @relation(fields: [applicationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  auditLogs   AuditLog[]
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  applicationId String?
  apiKeyId      String?
  action        String // e.g., "UPLOAD", "DELETE", "LOGIN", "GENERATE_KEY"
  targetId      String? // imageId or resourceId
  ip            String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user        User?        @relation(fields: [userId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])
  apiKey      ApiKey?      @relation(fields: [apiKeyId], references: [id])
}

// Connections belong to a user. Default and Local are built-ins, not DB secrets.
model StorageConnection {
  id                   String   @id @default(cuid())
  ownerId              String
  name                 String
  provider             String   @default("s3")
  endpoint             String
  bucket               String
  region               String   @default("auto")
  forcePathStyle       Boolean  @default(true)
  encryptedCredentials String
  enabled              Boolean  @default(true)
  deliveryMode         String   @default("proxy")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([ownerId])
}

model Folder {
  id            String             @id @default(cuid())
  applicationId String
  name          String
  parentId      String?
  deletedAt     DateTime?
  trashBatchId  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parent        Folder?            @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Folder[]           @relation("FolderTree")
  files         ImageApplication[]

  @@index([applicationId, parentId, deletedAt])
}
